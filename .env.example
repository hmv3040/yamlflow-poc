YAMLFLOW_SOURCE_MODE=fixture
# Switch mode to erpnext once you have a self-hosted ERPNext instance and API user.
ERPNEXT_URL=http://host.docker.internal:8080
# Format: api_key:api_secret. Keep the real value in .env, never in project YAML.
ERPNEXT_TOKEN=

# Optional: required only for open-ended AI agent mode in Streamlit.
OPENAI_API_KEY=
OPENAI_MODEL=
